	<External>nil</External>
	<Item class="Folder" referent="RBX26EA0258823945AB9B600935EE8FEA3E">
		<Properties>
			<Color3 name="IconTint">
				<R>0</R>
				<G>0</G>
				<B>0</B>
			</Color3>
			<BinaryString name="AttributesSerialize"></BinaryString>
			<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
			<bool name="DefinesCapabilities">false</bool>
			<string name="Name">RSEnvironmentMaker</string>
			<int64 name="SourceAssetId">-1</int64>
			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
		</Properties>
		<Item class="Script" referent="RBXC75C28010DB049B4A323514377713501">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local RS=game:GetService("RunService")if not plugin then return end
if not RS:IsEdit()then return end

local toolbar = plugin:CreateToolbar("Rose Of Sharon")

local PluginButton = toolbar:CreateButton(
	"Convert Environment To Table",
	"Allows you to convert Instances found in Lighting to a table used for Rose of Sharon configuration module script.",
	"rbxassetid://132667003942663"
)

local WI = DockWidgetPluginGuiInfo.new(
	Enum.InitialDockState.Float,
	false,
	false,
	800, 400,
	800, 400
)

local widget = plugin:CreateDockWidgetPluginGuiAsync("LoadBuild",WI)
widget.Title = "Convert Environment To Table"

local frame=script.Parent:WaitForChild("Frame")
frame.Parent=widget

local envname=frame:WaitForChild("EnvName")
local copynpaste=frame:WaitForChild("TextBox")
local parsebtn=frame:WaitForChild("TextButton")
local errormsg=frame:WaitForChild("TextLabel")

PluginButton.Click:Connect(function()
	widget.Enabled = not widget.Enabled
end)

local lt=game:GetService("Lighting")
local LTPROP={
	"Ambient",
	"Brightness",
	"ColorShift_Bottom",
	"ColorShift_Top",
	"EnvironmentDiffuseScale",
	"EnvironmentSpecularScale",
	"OutdoorAmbient",
	"ClockTime",
	"GeographicLatitude",
	"ExposureCompensation",
}
local StandardObjects={
	Atmosphere={
		"Density",
		"Offset",
		"Haze",
		"Glare",
		"Color",
		"Decay",
	},
	Sky={
		"CelestialBodiesShown",
		"MoonAngularSize",
		"MoonTextureId",
		"SunAngularSize",
		"SunTextureId",
		"SkyboxBk",
		"SkyboxDn",
		"SkyboxFt",
		"SkyboxLf",
		"SkyboxRt",
		"SkyboxUp",
		"SkyboxOrientation",
		"StarCount",
	},
	Bloom={
		"Enabled",
		"Size",
		"Intensity",
		"Threshold",
	},
	ColorCorrection={
		"Enabled",
		"Brightness",
		"Contrast",
		"Saturation",
		"TintColor",
	},
	DepthOfField={
		"Enabled",
		"FarIntensity",
		"FocusDistance",
		"InFocusRadius",
		"NearIntensity",
	},
	SunRays={
		"Enabled",
		"Intensity",
		"Spread",
	},

}
local parse=require(script:WaitForChild("Parse"))

parsebtn.MouseButton1Click:Connect(function()
	local nm = envname.Text
	local honhai = ""

	for _,v in pairs(LTPROP)do
		honhai..="	"..v.."={false,"..parse.GeneralParser(lt[v]).."},\n"
	end
	for nm,list in pairs(StandardObjects)do
		local doesitexist=lt:FindFirstChild(nm)
		if not doesitexist then continue end
		honhai..="	"..nm.."={true,{\n"
		for _,v in pairs(list)do
			honhai..="		"..v.."="..parse.GeneralParser(doesitexist[v])..",\n"
		end
		honhai..="	}},\n"
	end
	
	local Parsed='["'..nm..'"]={\n'..honhai..'},'
	copynpaste.Text=Parsed
	errormsg.Text="Parsed Environment: "..nm.." >~< Ready to Deploy!"
end)]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{5DEC1967-0BF6-4BCE-A7EF-796848D7A445}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<string name="Name">RSMain</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			</Properties>
			<Item class="ModuleScript" referent="RBX125089B8DE114709832143433DA84DF3">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Parse = {}

Parse.ParseType = {
	["nil"] = function(N:nil):string
		return "nil"
	end,
	boolean = function(bool:boolean):string
		return tostring(bool)
	end,
	number = function(num:number):string
		return tostring(num)
	end,
	string = function(str:string):string
		return '"'..str..'"'
	end,
	["Color3"] = function(color:Color3):string
		return "Color3.new("..tostring(color)..")"
	end,
	["EnumItem"] = function(enum:EnumItem):string
		return "Enum."..tostring(enum.EnumType).."."..enum.Name
	end,
	["Vector3"] = function(v3:Vector3):string
		return "Vector3.new("..tostring(v3)..")"
	end,
}

Parse.GeneralParser = function(any:any):string
	local typ=typeof(any)
	local K=Parse.ParseType[typ]
	if not K then return nil end
	return K(any)
end

return Parse
]]></ProtectedString>
