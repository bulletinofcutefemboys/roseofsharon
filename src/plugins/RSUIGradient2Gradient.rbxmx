			</Properties>
			<Item class="ModuleScript" referent="RBX218AA1A15D9D40169332961BEA5001B4">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local Parse = {}

Parse.ParseType = {
	number = function(num:number):string
		return tostring(num)
	end,
	["Color3"] = function(color:Color3):string
		return "Color3.new("..tostring(color)..")"
	end,
	["Vector2"] = function(v2:Vector2):string
		if v2.Magnitude==0 then return "Vector2.zero" end
		if v2==Vector2.one then return "Vector2.one" end
		if v2==Vector2.xAxis then return "Vector2.xAxis" end
		if v2==Vector2.yAxis then return "Vector2.yAxis" end
		return "Vector2.new("..tostring(v2)..")"
	end,
	["ColorSequence"] = function(cg:ColorSequence):string
		local cgk=cg.Keypoints
		if #cgk==2 then
			local K1,K2=cgk[1].Value,cgk[2].Value
			if K1==K2 then
				return "ColorSequence.new("..Parse.ParseType.Color3(K1)..")"
			else
				return "ColorSequence.new("..Parse.ParseType.Color3(K1)..", "..Parse.ParseType.Color3(K2)..")"
			end
		else
			local honhai="ColorSequence.new({\n"
			for i=1,#cgk do
				local K=cgk[i]
				honhai..="		ColorSequenceKeypoint.new("..tostring(K.Time)..","..Parse.ParseType.Color3(K.Value).."),\n"
			end
			return honhai.."	})"
		end
	end,
}

Parse.GeneralParser = function(any:any):string
	local typ=typeof(any)
	local K=Parse.ParseType[typ]
	if not K then return nil end
	return K(any)
end

return Parse
]]></ProtectedString>
