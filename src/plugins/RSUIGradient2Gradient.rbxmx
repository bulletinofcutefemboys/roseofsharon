		<Item class="Script" referent="RBX64D57502BCF5419D98B444623D320E70">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local RS=game:GetService("RunService")if not plugin then return end
if not RS:IsEdit()then return end

local toolbar = plugin:CreateToolbar("Rose Of Sharon")

local PluginButton = toolbar:CreateButton(
	"Convert UIGradient To Gradient",
	"Allows you to convert UIGradient Instances to a Luau table used for Rose of Sharon configuration module script.",
	"rbxassetid://132667003942663"
)

local WI = DockWidgetPluginGuiInfo.new(
	Enum.InitialDockState.Float,
	false,
	false,
	800, 400,
	800, 400
)

local widget = plugin:CreateDockWidgetPluginGuiAsync("LoadBuild",WI)
widget.Title = "Convert UIGradient To Gradient"

local frame=script.Parent:WaitForChild("Frame")
frame.Parent=widget

local findobj=frame:WaitForChild("FindObj")
local chooseobj=frame:WaitForChild("Choose")
local copynpaste=frame:WaitForChild("TextBox")
local parsebtn=frame:WaitForChild("TextButton")
local errormsg=frame:WaitForChild("TextLabel")

PluginButton.Click:Connect(function()
	widget.Enabled = not widget.Enabled
end)

local parse=require(script:WaitForChild("Parse"))
local Select=game:GetService("Selection")
local selected,foxconnexion=nil,{}

findobj.MouseButton1Click:Connect(function()
	if selected then
		Select:Set({selected})
	else
		errormsg.Text="Select an UIGradient object first."
	end
end)

chooseobj.MouseButton1Click:Connect(function()
	selected=Select:Get()[1]
	if foxconnexion[1]then foxconnexion[1]:Disconnect()end
	if selected then
		if selected:IsA("UIGradient")then
			findobj.Text="Click to Find me! ObjPath: "..selected:GetFullName()
			foxconnexion[1]=selected.AncestryChanged:Connect(function()
				findobj.Text="Click to Find me! ObjPath: "..selected:GetFullName()
			end)
		else
			selected=nil
			errormsg.Text="Not a valid UIGradient Instance."
			findobj.Text="Click to Find me! ObjPath: NULL"
		end
	else
		errormsg.Text="Select an object first."
		findobj.Text="Click to Find me! ObjPath: NULL"
	end
end)

local PROP={"Color","Rotation","Offset"}
parsebtn.MouseButton1Click:Connect(function()
	if not selected then errormsg.Text="Couldnt parse D:" return end
	local honhai=""
	for _,v in ipairs(PROP)do
		honhai..="	"..v.."="..parse.GeneralParser(selected[v])..",\n"
	end
	
	local Parsed='{\n'..honhai..'},'
	copynpaste.Text=Parsed
	errormsg.Text="Parsed Environment: "..selected.Name.." >~< Ready to Deploy!"
end)]]></ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null></null></Content>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{6FBF5BF1-2B53-475D-A8B4-0DAE574AAA63}</string>
